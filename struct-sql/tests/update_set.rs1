mod common;

#[cfg(test)]
mod tests {
    use crate::common::sql_args_to_bytes;
    use bytes::BytesMut;
    use postgres_types::ToSql;
    use struct_sql::sql_builder::{SqlArgs, SqlBuilder};
    use struct_sql::update_set::{TUpdateValue, UpdateValue};
    use struct_sql_derive::StructSql;

    ///
    /// ```sql
    /// CREATE TABLE IF NOT EXISTS update_set_table
    /// (
    ///     update_set_column integer
    /// )
    /// ```
    ///
    #[derive(StructSql, Debug)]
    #[struct_sql_table = "update_set_table"]
    struct UpdateSetTable {
        #[struct_sql_column(name = "update_set_column", is_indexed = true)]
        update_set_column: i32,
    }
    const TABLE: UpdateSetTable = UpdateSetTable {
        update_set_column: 0,
    };
    const STRUCT_SQL_TABLE: UpdateSetTableStructSql = UpdateSetTableStructSql {};

    #[test]
    fn update_set() {
        let mut sb = SqlBuilder::default();
        let update = UpdateValue::from([(
            STRUCT_SQL_TABLE.column_update_set_column(),
            &TABLE.update_set_column as &(dyn ToSql + Sync),
        )]);

        update.update_value(&mut sb);

        let (left_sql, left_args) = sb.sql_command();
        let (right_sql, right_args) = (
            " set \"update_set_column\" = $1",
            vec![&TABLE.update_set_column as &(dyn ToSql + Sync)],
        );

        assert_eq!(left_sql, right_sql);

        let (mut left_bytes_mut, mut right_bytes_mut) = (BytesMut::default(), BytesMut::default());

        writes_sql_args_to_bytes(
            right_sql,
            left_args,
            right_args,
            &mut left_bytes_mut,
            &mut right_bytes_mut,
        );

        assert_eq!(left_bytes_mut, right_bytes_mut);
    }

    fn writes_sql_args_to_bytes(
        sql: &str,
        left_args: SqlArgs,
        right_args: SqlArgs,
        mut left_bytes_mut: &mut BytesMut,
        mut right_bytes_mut: &mut BytesMut,
    ) {
        let sql = format!("{}{}", "update update_set_table", sql);

        sql_args_to_bytes(sql.as_str(), &left_args, &mut left_bytes_mut);
        sql_args_to_bytes(sql.as_str(), &right_args, &mut right_bytes_mut);
    }
}
