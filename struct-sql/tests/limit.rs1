#[cfg(test)]
mod tests {
    use struct_sql::limit::{Limit, TLimit};
    use struct_sql::sql_builder::SqlBuilder;

    #[test]
    fn limit() {
        let mut sb = SqlBuilder::default();

        let limit: Limit = 1;
        limit.limit(&mut sb);

        let (left_sql, _) = sb.sql_command();

        let right_sql = " limit 1";

        assert_eq!(left_sql, right_sql)
    }
}
