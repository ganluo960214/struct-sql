        assert_eq!(left_sql, right_sql);

        let (mut left_bytes_mut, mut right_bytes_mut) = (BytesMut::new(), BytesMut::new());

        writes_sql_args_to_bytes(
            right_sql,
            left_args,
            right_args,
            &mut left_bytes_mut,
            &mut right_bytes_mut,
        );

        assert_eq!(left_bytes_mut, right_bytes_mut);
    }

    #[test]
    fn condition_is_true() {
        let mut sb = SqlBuilder::default();
        let c = IsTrue(STRUCT_SQL_TABLE.column_condition_name());
        c.condition(&mut sb);

        let (left_sql, _) = sb.sql_command();

        let right_sql = " condition_table.\"condition_name\" is true";
        assert_eq!(left_sql, right_sql);
    }

    #[test]
    fn condition_is_not_true() {
        let mut sb = SqlBuilder::default();
        let c = IsNotTrue(STRUCT_SQL_TABLE.column_condition_name());
        c.condition(&mut sb);

        let (left_sql, _) = sb.sql_command();

        let right_sql = " condition_table.\"condition_name\" is not true";
        assert_eq!(left_sql, right_sql);
    }

