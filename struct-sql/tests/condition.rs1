    }

    fn writes_sql_args_to_bytes(
        sql: &str,
        left_args: SqlArgs,
        right_args: SqlArgs,
        left_bytes_mut: &mut BytesMut,
        right_bytes_mut: &mut BytesMut,
    ) {
        let sql = format!("{}{}", "select * from condition_table where", sql);

        common::writes_sql_args_to_bytes(
            sql.as_str(),
            left_args,
            right_args,
            left_bytes_mut,
            right_bytes_mut,
        )
    }
}
